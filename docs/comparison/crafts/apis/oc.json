{
  "apiId": "oc",
  "versionCode": 1,
  "endpoints": [
    {
      "id": "meta",
      "sparqlURI": "http://meta:3030/sparql",
      "httpMethod": "GET"
    },
    {
      "id": "index",
      "sparqlURI": "http://index:3030/sparql",
      "httpMethod": "GET"
    },
    {
      "id": "metaBasic",
      "sparqlURI": "http://meta-basic:3030/sparql",
      "httpMethod": "GET",
      "authInfo": {
        "type": "basic",
        "user": "demo",
        "password": "demo"
      }
    },
    {
      "id": "metaWrite",
      "sparqlURI": "http://meta-write:3030/sparql",
      "httpMethod": "GET",
      "sparqlUpdate": {
        "sparqlURI": "http://crafts-update-proxy/sparql",
        "httpMethod": "GET"
      }
    },
    {
      "id": "metaCounted",
      "sparqlURI": "http://meta-counted:7001/sparql",
      "httpMethod": "GET"
    }
  ],
  "model": [
    {
      "id": "article",
      "types": [],
      "props": [
        {
          "label": "title",
          "endpoint": "meta",
          "proptype": "datatype",
          "propiri": "http://purl.org/dc/terms/title"
        },
        {
          "label": "references",
          "endpoint": "index",
          "proptype": "object",
          "propexpr": "^<http://purl.org/spar/cito/hasCitingEntity>"
        }
      ]
    },
    {
      "id": "writableArticle",
      "types": [],
      "props": [
        {
          "label": "title",
          "endpoint": "metaWrite",
          "proptype": "datatype",
          "propiri": "http://purl.org/dc/terms/title"
        }
      ]
    },
    {
      "id": "countedArticle",
      "types": [],
      "props": [
        {
          "label": "title",
          "endpoint": "metaCounted",
          "proptype": "datatype",
          "propiri": "http://purl.org/dc/terms/title"
        }
      ]
    },
    {
      "id": "identifiedArticle",
      "types": [],
      "props": [
        {
          "label": "identifiers",
          "endpoint": "meta",
          "proptype": "datatype",
          "propexpr": "<http://purl.org/spar/datacite/hasIdentifier>/<http://www.essepuntato.it/2010/06/literalreification/hasLiteralValue>"
        }
      ],
      "joins": [
        {
          "label": "titleByIdentifier",
          "endpoint": "metaBasic",
          "source": "identifiers",
          "inputTransform": "\"{{{input}}}\"",
          "proptype": "datatype",
          "propexpr": "^<http://www.essepuntato.it/2010/06/literalreification/hasLiteralValue>/^<http://purl.org/spar/datacite/hasIdentifier>/<http://purl.org/dc/terms/title>"
        }
      ]
    }
  ],
  "queryTemplates": [
    {
      "id": "articleByDoi",
      "endpoint": "meta",
      "description": "Resolve a DOI to the OpenCitations OMID of the bibliographic resource and its title",
      "template": "SELECT ?br ?title WHERE { ?id <http://purl.org/spar/datacite/usesIdentifierScheme> <http://purl.org/spar/datacite/doi> ; <http://www.essepuntato.it/2010/06/literalreification/hasLiteralValue> \"{{{doi}}}\" . ?br <http://purl.org/spar/datacite/hasIdentifier> ?id ; <http://purl.org/dc/terms/title> ?title . }",
      "variables": [
        "br",
        "title"
      ],
      "parameters": [
        {
          "label": "doi",
          "type": "string"
        }
      ]
    },
    {
      "id": "titleBasic",
      "endpoint": "metaBasic",
      "description": "Resolve a DOI to its title on the copy of Meta that requires HTTP Basic credentials",
      "template": "SELECT ?title WHERE { ?id <http://www.essepuntato.it/2010/06/literalreification/hasLiteralValue> \"{{{doi}}}\" . ?br <http://purl.org/spar/datacite/hasIdentifier> ?id ; <http://purl.org/dc/terms/title> ?title . }",
      "variables": [
        "title"
      ],
      "parameters": [
        {
          "label": "doi",
          "type": "string"
        }
      ]
    }
  ]
}
