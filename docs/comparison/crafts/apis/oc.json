{
  "apiId": "oc",
  "endpoints": [
    {
      "id": "meta",
      "sparqlURI": "http://meta:3030/sparql",
      "httpMethod": "GET"
    },
    {
      "id": "index",
      "sparqlURI": "http://index:3030/sparql",
      "httpMethod": "GET"
    },
    {
      "id": "metaBasic",
      "sparqlURI": "http://meta-basic:3030/sparql",
      "httpMethod": "GET",
      "authInfo": { "type": "basic", "user": "demo", "password": "demo" }
    }
  ],
  "model": [
    {
      "id": "article",
      "types": [],
      "dprops": [
        {
          "label": "title",
          "endpoint": "meta",
          "iri": "http://purl.org/dc/terms/title"
        }
      ],
      "oprops": [
        {
          "label": "references",
          "endpoint": "index",
          "iri": "http://purl.org/spar/cito/hasCitingEntity",
          "inv": true
        }
      ]
    }
  ],
  "queryTemplates": [
    {
      "id": "articleByDoi",
      "endpoint": "meta",
      "description": "Resolve a DOI to the OpenCitations OMID of the bibliographic resource and its title",
      "template": "SELECT ?br ?title WHERE { ?id <http://purl.org/spar/datacite/usesIdentifierScheme> <http://purl.org/spar/datacite/doi> ; <http://www.essepuntato.it/2010/06/literalreification/hasLiteralValue> \"{{{doi}}}\" . ?br <http://purl.org/spar/datacite/hasIdentifier> ?id ; <http://purl.org/dc/terms/title> ?title . }",
      "variables": ["br", "title"],
      "parameters": [
        { "label": "doi", "type": "string" }
      ]
    },
    {
      "id": "titleBasic",
      "endpoint": "metaBasic",
      "description": "Resolve a DOI to its title on the copy of Meta that requires HTTP Basic credentials",
      "template": "SELECT ?title WHERE { ?id <http://www.essepuntato.it/2010/06/literalreification/hasLiteralValue> \"{{{doi}}}\" . ?br <http://purl.org/spar/datacite/hasIdentifier> ?id ; <http://purl.org/dc/terms/title> ?title . }",
      "variables": ["title"],
      "parameters": [
        { "label": "doi", "type": "string" }
      ]
    }
  ]
}
